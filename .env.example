# Keen platform credentials — SERVER-ONLY (no NEXT_PUBLIC_ prefix).
#
# Copy this file to .env.local and fill in the real values:
#   cp .env.example .env.local
#
# .env.local is gitignored; this example is the committed documentation of the
# key names. readKeenConfig() (src/service/services/keen/keen.ts) throws at
# startup if any of these is missing.

# The Keen edge base URL (dev: https://localhost behind a self-signed cert).
KEEN_HOST=https://localhost

# The relay WebSocket endpoint the chat client connects to. OPTIONAL — if unset,
# the chat SDK falls back to CHAT_SETTINGS.WS_URL (src/service/services/chat/settings.ts).
# Behind nginx the public path is /ws-keen (wss://<host>/ws-keen); use ws:// only on
# plain http. Point it straight at the relay's real domain, NOT through a free ngrok
# tunnel (which can't carry a browser WebSocket upgrade).
KEEN_WS=wss://your-sandbox-host/ws-keen

# This app's public origin — MUST be allow-listed on the Keen api_key, or every
# request is dropped by the relay's OriginGuard. scheme://host[:port], exact match.
KEEN_ORIGIN=http://your-allow-listed-origin:3000

# Partner credentials issued by Keen for the api_key.
KEEN_CLIENT_ID=
KEEN_CLIENT_SECRET=
KEEN_API_KEY_ID=
KEEN_API_KEY_SECRET=
